# ===================================================================
# SIVACINE AI / NPTEL MANAGEMENT SYSTEM &bull; ENVIRONMENT CONFIGURATION (.env)
# ===================================================================

PORT=5000
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# JWT Secret Key (Used for signing authentication session tokens)
JWT_SECRET=sivacine_ai_super_secret_jwt_key_2026_cinema_filmmaker

# -------------------------------------------------------------------
# GOOGLE OAUTH 2.0 CREDENTIALS
# How to get them:
# 1. Visit Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Application type: Web application)
# 3. Add Authorized JavaScript origin: http://localhost:3000
# 4. Add Authorized redirect URI: http://localhost:5000/auth/google/callback
# -------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# -------------------------------------------------------------------
# GITHUB OAUTH 2.0 CREDENTIALS (OPTIONAL)
# 1. Visit GitHub Developer Settings: https://github.com/settings/developers
# 2. Add Homepage URL: http://localhost:3000
# 3. Add Authorization callback URL: http://localhost:5000/auth/github/callback
# -------------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback

# -------------------------------------------------------------------
# SUPABASE POSTGRESQL DATABASE CONFIGURATION
# Option A: Direct Connection URL (Recommended)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# -------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Option B: Discrete Parameters (Optional fallback)
DB_HOST=db.YOUR_PROJECT_REF.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_SUPABASE_PASSWORD
DB_NAME=postgres
DB_SSL=true
