# ===================================================================
# AI STORYTELLING PLATFORM &bull; POSTGRESQL, GEMINI & FASTAPI CONFIGURATION
# ===================================================================

# 1. Supabase Cloud PostgreSQL Connection URL
# Direct Connection (Port 5432, Recommended):
# Format: postgresql+psycopg://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres?sslmode=require
# Or Supabase Session Pooler (Port 5432):
# Format: postgresql+psycopg://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# Note: postgresql:// is also supported and automatically normalized to the psycopg driver.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# 2. Frontend Allowed Origin (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# 3. Environment (development / production)
ENVIRONMENT=development

# 4. JWT Secret Key for Session Authentication
JWT_SECRET=your_super_secret_jwt_key_here_2026

# 5. Google Gemini AI API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 6. Audio Artifacts & Story Output Storage Root
OUTPUT_ROOT=./outputs

# 7. Self-Hosted TTS Module (Thunder Compute / Local GPU)
# Options: mock, kokoro, vibevoice, edge, system
TTS_PROVIDER=mock
TTS_MODEL_PATH=
